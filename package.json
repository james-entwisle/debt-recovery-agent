{
  "name": "debt-recovery-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:api": "cd apps/api && mix run --no-halt",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test:api": "cd apps/api && mix test"
  }
}
